{
  "name": "datatwist",
  "displayName": "DataTwist",
  "description": "Syntax highlighting and language support for DataTwist",
  "version": "0.1.0",
  "publisher": "datatwist",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "datatwist",
        "aliases": [
          "DataTwist",
          "datatwist"
        ],
        "extensions": [
          ".dt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "datatwist",
        "scopeName": "source.datatwist",
        "path": "./syntaxes/datatwist.tmLanguage.json"
      }
    ]
  }
}
