(* DataTwist Grammar - Prototype *)
(* Covers: literals, identifiers, operators, precedence *)
(* Uses :auto-whitespace :standard *)

Program = Expr+

<Expr> = OrExpr

(* Operator precedence via nesting: lowest to highest *)

OrExpr = AndExpr (<'or'> AndExpr)+
       | AndExpr

AndExpr = NilCoalesce (<'and'> NilCoalesce)+
        | NilCoalesce

NilCoalesce = NotExpr (<'??'> NotExpr)+
            | NotExpr

NotExpr = <'not'> CompExpr
        | CompExpr

CompExpr = InExpr CompOp InExpr
         | InExpr

InExpr = AddExpr <'in'> AddExpr
       | AddExpr

AddExpr = MulExpr (AddOp MulExpr)+
        | MulExpr

MulExpr = UnaryExpr (MulOp UnaryExpr)+
        | UnaryExpr

UnaryExpr = <'-'> Atom
          | Atom

<Atom> = Float
       | Integer
       | String
       | Boolean
       | Nil
       | Identifier
       | Wildcard
       | <'('> Expr <')'>

(* Operator tokens - kept visible for AST *)
AddOp = '+' | '-'
MulOp = '*' | '/' | '%'
CompOp = '>=' | '<=' | '!=' | '=' | '>' | '<'

(* Literals *)
Float = #'[0-9]+\.[0-9]+'
Integer = #'[0-9]+'
String = <'"'> #'[^"\\]*(?:\\.[^"\\]*)*' <'"'>
Boolean = 'true' | 'false'
Nil = 'nil'

(* Identifiers and wildcard *)
Identifier = !ReservedWord #'[a-zA-Z][a-zA-Z0-9_-]*[?!]?'
Wildcard = '_'
ReservedWord = ('true' | 'false' | 'nil' | 'and' | 'or' | 'not' | 'is' | 'in') !#'[a-zA-Z0-9_-]'

(* Comments - consumed but not in AST *)
Comment = <'//'> <#'[^\r\n]*'>
